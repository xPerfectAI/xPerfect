# Build from the digest-verified native image produced by the reviewed workstation recipe.
ARG XPERFECT_NATIVE_IMAGE
FROM docker:29.6.1-cli@sha256:862099ada15c669000bef53aa4cb9d821262829f45b0dda2159ccb276443043b AS docker-cli
FROM ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa AS uv
FROM ${XPERFECT_NATIVE_IMAGE}
USER root
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/xperfect
COPY runtime_phase1/pyproject.toml runtime_phase1/uv.lock runtime_phase1/LICENSE runtime_phase1/NOTICE ./runtime_phase1/
COPY frontends/glass-drive-ui/pyproject.toml frontends/glass-drive-ui/uv.lock frontends/glass-drive-ui/LICENSE frontends/glass-drive-ui/NOTICE ./frontends/glass-drive-ui/
RUN UV_PROJECT_ENVIRONMENT=/opt/xperfect/venvs/runtime uv sync --frozen --no-dev --no-install-project --python /usr/bin/python3 --project runtime_phase1 \
 && UV_PROJECT_ENVIRONMENT=/opt/xperfect/venvs/ui uv sync --frozen --no-dev --no-install-project --python /usr/bin/python3 --project frontends/glass-drive-ui
COPY runtime_phase1/src ./runtime_phase1/src
COPY runtime_phase1/workstation-requirements.lock ./runtime_phase1/workstation-requirements.lock
COPY frontends/glass-drive-ui/src ./frontends/glass-drive-ui/src
COPY deployment/linux/service.py ./deployment/linux/service.py
RUN UV_PROJECT_ENVIRONMENT=/opt/xperfect/venvs/runtime uv sync --frozen --no-dev --python /usr/bin/python3 --project runtime_phase1 \
 && UV_PROJECT_ENVIRONMENT=/opt/xperfect/venvs/ui uv sync --frozen --no-dev --python /usr/bin/python3 --project frontends/glass-drive-ui
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/usr/bin/python3", "/opt/xperfect/deployment/linux/service.py"]
